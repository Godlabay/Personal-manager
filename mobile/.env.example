# Expo public env vars — anything prefixed with EXPO_PUBLIC_ is bundled into the JS
# and readable at runtime via process.env. NEVER put secrets (API keys, JWTs) here.
# Supabase anon keys are safe because RLS protects data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

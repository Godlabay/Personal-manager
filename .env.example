# Copy this file to .env and fill in the values.
# The iOS app reads these at build time via XcodeGen; Supabase CLI reads them directly.

# ---- Supabase ----
# Find these in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Only used by local tooling / migrations. NEVER ship this in the iOS app.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- AI (BYOK) ----
# These are NOT used by the app — users paste their own keys in Settings.
# They are only here for local smoke tests of LLM providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
